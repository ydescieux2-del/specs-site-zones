  InputLines:
    - '// @ui {"widget":"label", "label":"Site Zones"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Scene"}'
    - '// @input SceneObject siteWorld {"hint":"Root of the site. Its origin is on the floor beside the truck, where the wearer starts"}'
    - "// @input SceneObject jobSite {\"hint\":\"The stand-in job site model (JobSite.glb). Only the crane's upper section is animated\"}"
    - '// @input SceneObject pathAnchor {"hint":"Parent for the path chevrons"}'
    - "// @input SceneObject workArea {\"hint\":\"Placed at the electrician's work area. The work area outline and label are built under it\"}"
    - "// @input SceneObject zonesRoot {\"hint\":\"Parent for the zones shown in the supervisor's view\"}"
    - "// @input SceneObject markersRoot {\"hint\":\"Parent for the supervisor's corner markers\"}"
    - '// @input SceneObject groundTarget {"hint":"Centered on the floor slab. Becomes the surface the supervisor pinches to drop corners"}'
    - '// @input AssignableType_1 roleSwitch {"hint":"The Supervisor / Electrician switch panel"}'
    - "// @input AssignableType_2 supervisorPanel {\"hint\":\"The supervisor's panel\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Wearer"}'
    - '// @input string startRole = "supervisor" {"hint":"Which view the Lens opens in. The supervisor goes first, because zones have to be marked before they can be shown", "widget":"combobox", "values":[{"label":"Supervisor", "value":"supervisor"}, {"label":"Electrician", "value":"electrician"}]}'
    - "// @input float eyeHeightCm = 165 {\"hint\":\"Height of the wearer's eyes above the floor, in cm. The site is placed this far below the glasses\", \"widget\":\"slider\", \"min\":120, \"max\":200, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"When things show"}'
    - '// @input float appearDistanceCm = 500 {"hint":"A zone appears when the electrician is this close to its edge, in cm", "widget":"slider", "min":100, "max":1000, "step":10}'
    - '// @input float dangerDistanceCm = 100 {"hint":"A zone turns from yellow to red this close to its edge, or inside it, in cm", "widget":"slider", "min":0, "max":300, "step":5}'
    - "// @input float warnDistanceCm = 200 {\"hint\":\"The beep and arrow can start this close to a zone's edge, in cm\", \"widget\":\"slider\", \"min\":50, \"max\":500, \"step\":5}"
    - '// @input float lookAwayDegrees = 20 {"hint":"The beep and arrow start when the zone is this many degrees from the center of his view", "widget":"slider", "min":5, "max":60, "step":1}'
    - '// @input float workAreaDistanceCm = 500 {"hint":"The work area marker appears this close to the end of the path, in cm", "widget":"slider", "min":100, "max":1000, "step":10}'
    - '// @input float beepVolume = 1 {"hint":"Loudness of the warning beep, 0 to 1", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Crane stand-in"}'
    - "// @input float craneSwingDegrees = 55 {\"hint\":\"How far the crane's upper section swings to each side, in degrees\", \"widget\":\"slider\", \"min\":0, \"max\":180, \"step\":1}"
    - '// @input float craneSwingSeconds = 28 {"hint":"Seconds for one full swing there and back", "widget":"slider", "min":5, "max":120, "step":1}'
    - '// @ui {"widget":"group_end"}'
