  InputLines:
    - '// @ui {"widget":"label", "label":"Supervisor / Electrician switch"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float buttonWidthCm = 15 {"hint":"Width of each of the two buttons, in cm", "widget":"slider", "min":8, "max":24, "step":0.5}'
